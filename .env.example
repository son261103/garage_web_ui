# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.
# Copy this file to .env and fill in real values. NEVER commit .env.

# Địa chỉ Admin API của Garage (trong mạng Docker dùng tên service "garage").
# Garage Admin API address (inside the Docker network use the service name).
GARAGE_ADMIN_URL=http://garage:3903

# Token quản trị Garage (admin_token trong garage.toml / .env của Garage).
# Garage admin token (the admin_token from Garage's garage.toml / .env).
GARAGE_ADMIN_TOKEN=doi-token-quan-tri-o-day

# Địa chỉ S3 API của Garage.
# Garage S3 API endpoint.
S3_ENDPOINT_URL=http://garage:3900

# Region S3 (phải khớp s3_region trong garage.toml, mặc định là "garage").
S3_REGION=garage

# --- Tùy chọn: thông tin đăng nhập S3 để duyệt / tải lên / tải xuống file ---
# --- Optional: S3 credentials for the object browser ---
# Tạo key bằng giao diện này (tab Khóa) hoặc bằng lệnh:
#   docker compose exec garage /garage key create app-key
# rồi gán quyền cho bucket, sau đó điền Key ID + Secret vào đây.
# Nếu để trống, tab File sẽ hiện hướng dẫn tạo key, các tab còn lại vẫn chạy bình thường.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cổng giao diện chạy bên trong container (không cần đổi).
# Port the UI listens on inside the container (no need to change).
PORT=8000
